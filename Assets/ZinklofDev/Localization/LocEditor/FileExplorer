using System;
using System.IO;
using UnityEngine;
using ZinklofDev;

namespace ZinklofDev.LocalizationEditor
{
    internal static class file()
    {
        private bool folder {get; private set;}
        private string name {get; private set;}
        private string path {get; private set;}
        private var[] children {get; private set;}
        private bool modified {get; private set;}
        private string[] lines

        public string[] GetLines()
        {
            if (folder)
                return new string[1];

            return lines;
        }

        public void SaveLines(string[] newLines)
        {
            if (folder)
                return;

            lines = newLines;
            modified = true;
        }
    }

    public class FileExplorer : MonoBehaviour
    {
        private void GetFileTree
        {
            ZinklofDev.Localization.LookUpKey("exampleKey")
        }
    }
}