[Engine]
engine.verbose : false
engine.allow_localization_fallback_to_english : false
engine.console : true
engine.show_fps : true
engine.show_more_performance : true 
engine.watermark : Experimental Build E-2604A (Build #{bldnmbr}) | Skills USA States 2026 | Jacksonville Florida
engine.build_number : 22
[Gameplay]
language : English
[Video]
framerate : -1
resolutionx : 1920
resolutiony : 1080
window_mode : FullscreenBorderless
[PostProcessing]
bloom : true
chromatic_aberation : true
dialouge_blur : true
[QualitySettings]
vsync : 0
anisotropic_filtering : 16
anti_ailiasing : 4
shadow_distance : 512
shadow_resolution : 0
texture_resolution_level : 3
texture_quality_level : 0
