  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=20>In compliance with the International Game Developers Association
    (IDGA)\nGame Crediting Guide 10.1 (March 2023)</size>\n\n<size=16>in all categories,
    names are in order of ammount of work done.</size>\n\n\n\n\n\n\n\n\n\n\n\n\n\n<b><color=#ab0101><size=70>BASTION
    ENGINE</color></size></b>\n<size=22>\n\n\n\n<b><size=26>Technical Director</size></b>\nCameron
    Galiano\n\n\n<b><size=26>Programming</size></b>\nCameron Galiano\nCole Hauser\n\n\n<b><Size=26>External
    Assistance</size></b>\nBunny83 (one function, stack overflow, 2024)\nDgoyette
    (one function, stack overflow, 2024)\n\n\n<b><size=26>Art Design</size></b>\nCameron
    Galiano\nLucas West\n\n\n\n\n\n\n\n\n\n\n<alpha=#00>ZINKLOF.DEV (LOGO)</alpha>\n<color=#0fffff>\n<b>Cheif
    Executive Officer</b>\nCameron Galiano\n\n\n<b>Lead Supervisor</b>\nCole Hauser\n\n\n<b>Additional
    Staff</b>\nJadon \"Luigi\" Vargo\nLucas West\n\n\n\n\n\n\n\n\n\n\n\n\n\n<alpha=#00>Band
    Of The Damned (LOGO)<alpha=#ff>\n</color><color=#aa6565>\n<b>Lead Designer</b>\nCameron
    Galiano\n\n\n<b>Lead Supervisor</b>\nCole Hauser\n\n\n<b>Lead Artist</b>\nLucas
    West\n\n\n<b>Programming</b>\nCameron Galiano\nCole Hauser\n\n\n<b>Art</b>\nLucas
    West\nCameron Galiano\n\n\n<b>Textures</b>\nCameron Galiano\n\n\n<b>Shaders</b>\nCameron
    Galiano\nCole Hauser\n\n\n<b>Modeling</b>\nJadon \"Luigi\" Vargo\nCameron Galiano\n\n\n<b>Fundraising/Investment</b>\nCameron
    Galiano \nCole Hauser\nJadon \"Luigi\" Vargo\nLucas West</color>\n\n\n_\n\n\n<b>Major
    Inspiration</b>\n<color=#007D90>XCOM 2</color>\nVarious Rouglikes\n\n\n<b>Mentors
    and Special Thanks</b>\nRonald \"Mr. Flowe\" Flowers\nAiden Mundell\nDani Dev\nSabastian
    Lague\n\n\n<b>External Testing</b>\nCarlos \"Gomez Squared\" Gomez-Gomez\nJacob
    \"Rhya\" McCall\nMitchel Arbano\n\n\n<b>Powered By:</b>\nUNITY 6.2\n<color=#ab0101>BASTION
    V.E2604</color>\n\n\n<b>Software Used</b>\nMaya 2024\nBlender\nPhotoshop\nPiskel\nVisual
    Studio\nGithub\nBandLab\nFL Studio\nAudacity</size>\n\n\n\n\n\n\n\n\n\n\n\n\n<size=32>\nAnd
    as always, thank you for playing!\n</size>\n\n<size=16>In loving memory of Aiden
    Mundell</size>\n\n\n\n\n\n\n\n\n\n<size=16>\xA9 2026 Zinklof.Dev. Band of The
    Damned and the BASTION Game Engine, including all associated assets and marketing
    materials, are protected under United States and international copyright laws.
    Zinklof.Dev reserves all rights. For more information, please visit the EULA
    page in settings, zinklof.dev/copyright or zinklof.dev/botd/copyright.</size>"
